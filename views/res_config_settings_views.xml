<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="website_config_settings_view_form_inherit_website_facebook_pixel" model="ir.ui.view">
    <field name="name">website.config.settings.view.form.inherit.website.facebook.pixel</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form" />
    <field name="arch" type="xml">


      <setting id="google_analytics_setting" position="after">
        <setting id="facebook_pixel_setting"
          help="Track website Activities, Improve your return on Advertising, Reach New and Existing
              Customers in Facebook Advertising">
          <field name="has_facebook_pixel" />

          <div class="content-group" invisible="not has_facebook_pixel">
            <div class="row mt16">
              <label class="col-lg-3 o_light_label" string="Measurement ID" for="facebook_pixel_key" />
              <field name="facebook_pixel_key" placeholder="XXXXXXXXXX"
                required="has_facebook_pixel" />
            </div>
          </div>

        </setting>
      </setting>


    </field>
  </record>
</odoo>